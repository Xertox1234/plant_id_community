{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-legal-publish.mjs",
    "build": "npm run type-check && vite build",
    "lint": "eslint .",
    "check:classes": "vite build && node scripts/check-tailwind-classes.mjs",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:health": "playwright test e2e/health-check.spec.js"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.33.0",
    "@tiptap/extension-mention": "^3.33.0",
    "@tiptap/suggestion": "^3.22.5",
    "axios": "^1.21.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sentry/react": "^11.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react-error-boundary": "^6.1.6",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
