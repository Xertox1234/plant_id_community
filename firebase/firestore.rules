rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the account's own sign-in, and only once its email is verified.
    // A Firebase login can be made by anyone with no consent and no app
    // account, so "signed in" alone must not open any path (auth audit M15).
    // Google sign-ins arrive verified; a password sign-in is verified by the
    // emailed link, and the app refreshes its token right after.
    function isVerifiedOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
    }

    // Identified plants: the offline-synced per-user collection, and the ONLY
    // path a client uses (FirestoreService: savePlant / getPlantsStream /
    // deletePlant). Rules do not cascade from a parent document, so this is
    // matched by its full path.
    match /users/{userId}/identified_plants/{plantId} {
      allow read, write: if isVerifiedOwner(userId);
    }

    // Everything else is closed. The rules for the user document,
    // plant_identifications, user_plants, disease_diagnoses, user_preferences
    // and sync_queue were removed 2026-11-10: no client or server code reads
    // or writes them, and they let any signed-in Firebase account store data.
    // The backend uses the Admin SDK, which these rules do not apply to.
    // Tests: scripts/test_firebase_rules_emulator.py (emulator).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
