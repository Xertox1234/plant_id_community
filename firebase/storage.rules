rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Nothing in the app reads or writes Firebase Storage: scan photos go to
    // the API (private R2 bucket) since #1251, and avatars are served by
    // Django. Every path is closed so a throwaway Firebase account cannot use
    // the bucket as hosting (auth audit 2026-11-10, M15).
    //
    // Rules do not cover a download URL that was already issued: its token
    // keeps working until the object is deleted.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
