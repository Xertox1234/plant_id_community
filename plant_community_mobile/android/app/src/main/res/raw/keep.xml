<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds shrink resources, and the shrinker cannot see a lookup by name.
  google_sign_in_android reads default_web_client_id that way, so without this
  rule Google sign-in fails in release builds only.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
