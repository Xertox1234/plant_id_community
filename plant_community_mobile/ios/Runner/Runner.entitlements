<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
	Debug + Profile entitlements (todo 286). Release is wired to
	Runner/RunnerRelease.entitlements (`production`) via CODE_SIGN_ENTITLEMENTS
	in Runner.xcodeproj/project.pbxproj, so `development` below no longer
	reaches a Distribution-signed archive.

	Profile deliberately stays on `development`: it is the `flutter run
	--profile` on-device path, not a distribution config — `flutter build ipa`
	uses Release. Keep any entitlement added here mirrored into
	RunnerRelease.entitlements.

	Still outstanding before the first TestFlight/App Store archive: the APNs
	authentication key must be created in the Apple Developer account and
	uploaded to the Firebase console. See
	docs/DEPLOYMENT_SECURITY_CHECKLIST.md → Mobile (Flutter).
-->
<dict>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
