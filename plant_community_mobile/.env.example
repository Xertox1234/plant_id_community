# Flutter Mobile App - Environment Configuration Reference
# Use these keys as the source of values passed with Flutter --dart-define.
# Do not commit files containing real production values.

# Django Backend API Configuration
# For local development, use http://localhost:8000/api/v1
# For production, use your deployed backend URL
API_BASE_URL=http://localhost:8000/api/v1

# Firebase Configuration (DO NOT COMMIT REAL VALUES)
# These values should match your Firebase project
# Get these from Firebase Console > Project Settings > General
# FIREBASE_API_KEY is the shared fallback. Prefer the per-platform keys below:
# Google allows exactly ONE application restriction per API key, so a key used by
# both Android and iOS cannot be restricted at all. See todos/382.
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_APP_ID=your-firebase-app-id-here
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id-here
FIREBASE_PROJECT_ID=your-firebase-project-id-here
FIREBASE_STORAGE_BUCKET=your-storage-bucket-here
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_MEASUREMENT_ID=your-measurement-id-here

# Web-specific Firebase Config
FIREBASE_WEB_API_KEY=your-web-api-key-here
FIREBASE_WEB_APP_ID=your-web-app-id-here

# iOS-specific Firebase Config
# API key: ios/Runner/GoogleService-Info.plist -> API_KEY
FIREBASE_IOS_API_KEY=your-ios-api-key-here
FIREBASE_IOS_BUNDLE_ID=com.plantcommunity.plantCommunityMobile
FIREBASE_IOS_APP_ID=your-ios-app-id-here

# Android-specific Firebase Config
# API key: android/app/google-services.json -> client[].api_key[].current_key
# Set FIREBASE_ANDROID_APP_ID alongside it — an Android key paired with the iOS
# appId is rejected at sign-in.
FIREBASE_ANDROID_API_KEY=your-android-api-key-here
FIREBASE_ANDROID_PACKAGE_NAME=com.plantcommunity.plant_community_mobile
FIREBASE_ANDROID_APP_ID=your-android-app-id-here

# OpenWeather API (for weather integration)
# Get API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Feature Flags (true/false)
ENABLE_ANALYTICS=false
ENABLE_CRASHLYTICS=false
DEBUG_MODE=true
